# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` al repositorio.
# Detalle de cada variable: specs/001-public-subscriptions-catalog/contracts/environment.md

# --- Obligatorias ---
# Usuario de solo lectura de la base compartida (docs/database/read-only-role.sql). Es el único secreto.
DATABASE_URL=postgresql+asyncpg://maily_public_api:cambiar-en-local@db-local:5432/postgres
# Orígenes del Frontend separados por comas (http(s)://host[:puerto], sin ruta ni *).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Opcionales (valor por omisión) ---
# CATALOG_CACHE_MAX_AGE_SECONDS=300
# DATABASE_QUERY_TIMEOUT_SECONDS=3
# DOCS_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
# TRUSTED_PROXY_HOPS=0

# --- Contrato de salud v1 ---
# HEALTH_READY_TIMEOUT_SECONDS=2
# APP_ENVIRONMENT=local
# APP_COMMIT_SHA y APP_BUILD_DATE llegan como argumentos del build de la imagen.

# --- Solo pruebas (nunca en la imagen ni en producción) ---
# Administrador de la base desechable `db-test`; el nombre de la base debe terminar en `_test`.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5436/maily_public_api_test
# Copia local de mailySoft-DB (esquema y catálogos de las pruebas `slow`).
# MAILYSOFT_DB_DIR=../mailySoft-DB
